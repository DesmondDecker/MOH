NODE_ENV=development
PORT=5000

# Single allowed origin for the frontend (or '*' for dev). Shared by the
# Express CORS middleware and the Socket.io CORS config.
CORS_ORIGIN=*

# MongoDB
# NEVER commit a real connection string here — this file is checked into
# version control. Put actual credentials only in a local, gitignored .env
# or in your secrets manager/deployment platform's env config.
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-host>/moh_registry?appName=Cluster0

# JWT
JWT_ACCESS_SECRET=change_this_to_a_long_random_string
JWT_REFRESH_SECRET=change_this_to_a_different_long_random_string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
# Short-lived token issued after password verification but before 2FA code
# verification completes — deliberately separate secret from the access/
# refresh tokens above so an MFA-pending token can never be replayed as a
# real access token even if it leaks.
JWT_MFA_SECRET=change_this_to_a_third_long_random_string
JWT_MFA_EXPIRES_IN=5m

# --- Field-level encryption at rest (PII/PHI) ---
# Generate with: node -e "console.log(JSON.stringify({v1: require('crypto').randomBytes(32).toString('base64')}))"
# See backend/services/encryptionService.js for key-rotation details.
# In production, source these from a KMS/secrets manager, not a flat file.
ENCRYPTION_KEYS={"v1":"REPLACE_WITH_GENERATED_BASE64_32_BYTE_KEY"}
ENCRYPTION_ACTIVE_KEY_VERSION=v1
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BLIND_INDEX_KEY=REPLACE_WITH_GENERATED_BASE64_32_BYTE_KEY

# --- TOTP 2FA ---
# Display name shown in the authenticator app (Google Authenticator, Authy, etc.)
TOTP_ISSUER=MOH Sierra Leone

# Bootstrap MoH super admin (used only by the seed script, one-time)
BOOTSTRAP_SUPER_ADMIN_EMAIL=superadmin@moh.gov.sl
BOOTSTRAP_SUPER_ADMIN_PASSWORD=ChangeMeImmediately123!

# --- Facility sync worker (only needed on a FACILITY deployment, not central) ---
MOH_CENTRAL_SYNC_URL=https://central.moh.gov.sl
SYNC_FACILITY_ID=
SYNC_FACILITY_API_KEY=
SYNC_INTERVAL_MS=30000